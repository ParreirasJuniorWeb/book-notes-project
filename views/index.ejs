<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - BookNotes</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <h1><i class="fas fa-book"></i> BookNotes</h1>
            <div class="header-actions">
                <a href="/profile" class="btn btn-secondary"><i class="fas fa-user"></i> Perfil</a>
                <form method="POST" action="/logout" style="display: inline;">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </form>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main">
        <div class="container">
            <!-- Stats & Actions -->
            <div class="stats-actions">
                <div class="stats">
                    <span class="stat-number"><%= books.length %></span>
                    <span class="stat-label">Anotações</span>
                </div>
                <a href="/new" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nova Anotação
                </a>
            </div>

            <!-- Books Grid -->
            <% if (books && books.length > 0) { %>
                <div class="books-grid">
                    <% books.forEach(book => { %>
                        <div class="book-card">
                            <% if (book.image) { %>
                                <img src="<%= book.image %>" alt="<%= book.title %>" class="book-cover">
                            <% } else { %>
                                <div class="book-cover-placeholder">
                                    <i class="fas fa-book"></i>
                                </div>
                            <% } %>
                            
                            <div class="book-content">
                                <h3 class="book-title"><%= book.title %></h3>
                                <% if(userId == book.author_id) { %>
                                    <p class="book-userPublish">Sua publicação!</p>
                                <% } %>        
                                <div class="book-meta">
                                    <span class="isbn">ISBN: <%= book.isbn %></span>
                                    <span class="rating">
                                        <i class="fas fa-star"></i> <%= book.recommendation_note || 'N/A' %>
                                    </span>
                                </div>
                                <p class="book-summary"><%= book.summary?.substring(0, 100) %>...</p>
                                <div class="book-date">
                                    📅 <%= new Date(book.reading_dt).toLocaleDateString('pt-BR') %>
                                </div>
                            </div>
                            
                            <div class="book-actions">
                                <a href="/book/<%= book.id %>" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-eye"></i> Visualizar
                                </a>
                                <% if(userId == book.author_id) { %>
                                <a href="/edit/<%= book.id %>" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <form method="POST" action="/books/<%= book.id %>/delete" 
                                      style="display: inline;" 
                                      onsubmit="return confirm('Tem certeza que deseja excluir esta anotação?')">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Excluir
                                    </button>
                                </form>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-book-open"></i>
                    <h2>Nenhuma anotação encontrada</h2>
                    <p>Comece criando sua primeira anotação de livro!</p>
                    <a href="/new" class="btn btn-primary">Criar Primeira Anotação</a>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>